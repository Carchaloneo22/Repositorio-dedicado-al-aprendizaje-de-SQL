--Ejercicio 12 (JOIN): Realice una consulta que combine tab_ciud y tab_dptos para mostrar el nombre de la ciudad y el nombre de su respectivo departamento.
SELECT c.nom_ciud, d.nom_dpto --Proyecta las columnas deseadas 
FROM tab_ciud c --Define la tabla principal (tab_ciud) y le asigna el alias c para simplificar la referencia a sus columnas.
INNER JOIN tab_dptos d ON c.id_dpto = d.id_dpto; -- Combina la tabla de ciudades con la tabla de departamentos (tab_dptos), asignándole a esta última el alias d.

--Ejercicio 13 (Subconsulta): Seleccione todos los productos de tab_prod cuyos IDs estén presentes en tab_prod_prov con un valor del producto (val_prod) superior a 2,000,000.
SELECT *
FROM tab_prod
WHERE id_prod IN --Filtra los productos de tab_prod cuyo identificador exista dentro de la lista devuelta por la subconsulta.
(
    SELECT id_prod
    FROM tab_prod_prov
    WHERE val_prod > 2000000 --Subconsulta que obtiene los IDs de los productos en tab_prod_prov cuyo valor registrado supera los 2,000,000.
);
--Ejercicio 14 (CASE): Clasifique a los proveedores según su cupo de crédito: 'Cupo Alto' (>= 5,000,000), 'Cupo Medio' (3,000,000 a 4,999,999) y 'Cupo Bajo' (< 3,000,000).
SELECT id_prov, nom_prov, val_cupocre,
       CASE                                   --Evalúa una secuencia de condiciones lógicas
           WHEN val_cupocre >= 5000000 THEN 'Cupo Alto' --Clasifica los cupos de 5,000,000 en adelante.
           WHEN val_cupocre >= 3000000 THEN 'Cupo Medio' --Evalúa los valores restantes entre 3,000,000 y 4,999,999.
           ELSE 'Cupo Bajo'               --Asigna esta categoría a todos los cupos menores a 3,000,000.    
       END AS clasificacion_cupo          --Nombre o alias para la columna calculada.
FROM tab_prov;

--Ejercicio 15 (UNION): Combine en un único listado sin duplicados los IDs de los productos pedidos en órdenes de compra y los facturados en detalles de compra.
SELECT id_prod
FROM tab_det_orden --Obtiene la lista de identificadores de productos registrados en los detalles de las órdenes de compra.
UNION                     --Combina los conjuntos de resultados de ambos.
