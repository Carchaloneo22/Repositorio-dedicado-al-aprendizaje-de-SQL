--Ejercicio 17 (HAVING): Muestre los IDs de las facturas en tab_det_compra que tengan asociadas más de 1 línea de detalle/producto.
SELECT id_factura, COUNT(*) AS total_lineas --Muestra el identificador de la factura y cuenta cuántas líneas de detalle o productos tiene registradas.
FROM tab_det_compra
GROUP BY id_factura  -- Agrupa los registros por cada factura individual para poder calcular el total de ítems por cada una.
HAVING COUNT(*) > 1;  --Filtra los grupos resultantes para conservar únicamente aquellas facturas cuya cantidad de ítems o líneas sea estrictamente mayor a 1.

--Ejercicio 18 (EXISTS): Seleccione los proveedores en tab_prov que tengan al menos una factura registrada en tab_enc_compra.
SELECT *
FROM tab_prov p
WHERE EXISTS (
    SELECT 1
    FROM tab_enc_compra e
    WHERE e.id_prov = p.id_prov
);

