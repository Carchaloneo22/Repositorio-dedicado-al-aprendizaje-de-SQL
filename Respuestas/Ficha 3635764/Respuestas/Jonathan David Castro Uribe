CREATE DATABASE Guia_BD_Compras_Normalizada;
CREATE TABLE tab_pmtros (
    id_empresa  DECIMAL(10,0) NOT NULL,  -- Identificador de la empresa.
    dia_pagos1  SMALLINT      NOT NULL,  -- Primer día de pagos (1=lunes ... 7=domingo).
    dia_pagos2  SMALLINT      NOT NULL,  -- Segundo día de pagos.
    dia_pagos3  SMALLINT      NOT NULL,  -- Tercer día de pagos.
    num_orden   DECIMAL(6,0)  NOT NULL,  -- Consecutivo de la próxima orden de compra.

  
    CONSTRAINT pk_pmtros
        PRIMARY KEY (id_empresa),

    
    CONSTRAINT ck_pmtros_id
        CHECK (id_empresa > 0),

 
    CONSTRAINT ck_pmtros_dias
        CHECK (
            dia_pagos1 BETWEEN 1 AND 7
            AND dia_pagos2 BETWEEN 1 AND 7
            AND dia_pagos3 BETWEEN 1 AND 7
            AND dia_pagos1 < dia_pagos2
            AND dia_pagos2 < dia_pagos3
        ),

       CONSTRAINT ck_pmtros_orden
        CHECK (num_orden > 0)
);
CREATE TABLE tab_dptos (
    id_dpto  VARCHAR(2)  NOT NULL,  -- Código del departamento (2 dígitos).
    nom_dpto VARCHAR(60) NOT NULL,  -- Nombre del departamento.


    CONSTRAINT pk_dptos
        PRIMARY KEY (id_dpto),

    CONSTRAINT uq_dptos_nombre
        UNIQUE (nom_dpto),


    CONSTRAINT ck_dptos_id
        CHECK (id_dpto ~ '^[0-9]{2}$'),


    CONSTRAINT ck_dptos_nombre
        CHECK (BTRIM(nom_dpto) <> '')
);
CREATE TABLE tab_ciud (
    id_ciud  VARCHAR(5)  NOT NULL,  -- Código de la ciudad (5 dígitos).
    nom_ciud VARCHAR(80) NOT NULL,  -- Nombre de la ciudad.
    id_dpto  VARCHAR(2)  NOT NULL,  -- Departamento al que pertenece.


    CONSTRAINT pk_ciud
        PRIMARY KEY (id_ciud),


    CONSTRAINT fk_ciud_dpto
        FOREIGN KEY (id_dpto)
        REFERENCES tab_dptos (id_dpto)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT uq_ciud_dpto_nombre
        UNIQUE (id_dpto, nom_ciud),

    CONSTRAINT ck_ciud_id
        CHECK (id_ciud ~ '^[0-9]{5}$'),

    CONSTRAINT ck_ciud_dpto
        CHECK (LEFT(id_ciud, 2) = id_dpto),

    CONSTRAINT ck_ciud_nombre
        CHECK (BTRIM(nom_ciud) <> '')
);
CREATE TABLE tab_prov (
    id_prov      DECIMAL(10,0) NOT NULL,  -- Identificador del proveedor.
    nom_prov     VARCHAR(60)   NOT NULL,  -- Nombres.
    ape1_prov    VARCHAR(60)   NOT NULL,  -- Primer apellido.
    ape2_prov    VARCHAR(60),             -- Segundo apellido (opcional).


    nom_comp     VARCHAR(185) GENERATED ALWAYS AS
                 (nom_prov || ' ' || ape1_prov || COALESCE(' ' || ape2_prov, ''))
                 STORED,

    dir_prov     VARCHAR(100)  NOT NULL,  -- Dirección.
    tel_prov     VARCHAR(10)   NOT NULL,  -- Teléfono (texto, para no perder ceros).
    email_prov   VARCHAR(100)  NOT NULL,  -- Correo electrónico.
    id_ciud      VARCHAR(5)    NOT NULL,  -- Ciudad donde está el proveedor.

    val_cupocre  DECIMAL(12,0) NOT NULL DEFAULT 0,    -- Cupo de crédito.
    val_puntos   DECIMAL(3,0)  NOT NULL DEFAULT 0,    -- Puntaje de evaluación (0 a 100).
    num_fact     DECIMAL(6,0)  NOT NULL,              -- Consecutivo de facturas del proveedor.
    ind_estado   BOOLEAN       NOT NULL DEFAULT TRUE, -- TRUE = activo, FALSE = inactivo.

    CONSTRAINT pk_prov
        PRIMARY KEY (id_prov),

    CONSTRAINT fk_prov_ciud
        FOREIGN KEY (id_ciud)
        REFERENCES tab_ciud (id_ciud)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT uq_prov_email
        UNIQUE (email_prov),

    CONSTRAINT ck_prov_id
        CHECK (id_prov > 0),

    CONSTRAINT ck_prov_tel
        CHECK (tel_prov ~ '^(60[124-8]|3[0-9]{2})[0-9]{7}$'),

    CONSTRAINT ck_prov_email
        CHECK (email_prov ~* '^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$'),

    CONSTRAINT ck_prov_cupo
        CHECK (val_cupocre >= 0),

    CONSTRAINT ck_prov_puntos
        CHECK (val_puntos BETWEEN 0 AND 100),

    CONSTRAINT ck_prov_fact
        CHECK (num_fact > 0)
        
);
CREATE TABLE tab_prod (
    id_prod     SMALLINT    NOT NULL,                 -- Identificador del producto.
    id_ref      VARCHAR(10) NOT NULL,                 -- Referencia (PROD + 3 dígitos).
    nom_prod    VARCHAR(80) NOT NULL,                 -- Nombre del producto.
    ind_estado  BOOLEAN     NOT NULL DEFAULT TRUE,    -- TRUE = activo.

    CONSTRAINT pk_prod
        PRIMARY KEY (id_prod),

    CONSTRAINT uq_prod_ref
        UNIQUE (id_ref),

    CONSTRAINT ck_prod_id
        CHECK (id_prod > 0),

    CONSTRAINT ck_prod_ref
        CHECK (id_ref ~ '^PROD[0-9]{3}$'),

    CONSTRAINT ck_prod_nombre
        CHECK (BTRIM(nom_prod) <> '')
);
CREATE TABLE tab_prod_prov (
    id_prov    DECIMAL(10,0) NOT NULL,               -- Proveedor.
    id_prod    SMALLINT      NOT NULL,               -- Producto.
    val_prod   DECIMAL(10,0) NOT NULL,               -- Precio de lista.
    ind_disp   BOOLEAN       NOT NULL DEFAULT TRUE,  -- TRUE = disponible.

    CONSTRAINT pk_prod_prov
        PRIMARY KEY (id_prov, id_prod),

    CONSTRAINT fk_prodprov_prov
        FOREIGN KEY (id_prov)
        REFERENCES tab_prov (id_prov)
        ON DELETE RESTRICT,

    CONSTRAINT fk_prodprov_prod
        FOREIGN KEY (id_prod)
        REFERENCES tab_prod (id_prod)
        ON DELETE RESTRICT,

     CONSTRAINT ck_prodprov_valor
        CHECK (val_prod > 0)
);
CREATE TABLE tab_areas (
    id_area     DECIMAL(2,0) NOT NULL,  -- Identificador del área.
    nom_area    VARCHAR  NOT NULL,  -- Nombre del área.
    nom_encarg  VARCHAR(100) NOT NULL,  -- Persona encargada.


    CONSTRAINT pk_areas
        PRIMARY KEY (id_area),


    CONSTRAINT uq_areas_nombre
        UNIQUE (nom_area),

    CONSTRAINT ck_areas_id
        CHECK (id_area > 0)
);
CREATE TABLE tab_orden_compra (
    id_orden    DECIMAL(6,0) NOT NULL,                            -- Número de la orden.
    fec_orden   TIMESTAMP    NOT NULL DEFAULT CURRENT_TIMESTAMP,  -- Fecha y hora de la orden.
    id_area     DECIMAL(2,0) NOT NULL,                            -- Área que solicita.

    CONSTRAINT pk_orden
        PRIMARY KEY (id_orden),

    CONSTRAINT fk_orden_area
        FOREIGN KEY (id_area)
        REFERENCES tab_areas (id_area)
        ON DELETE RESTRICT,

    CONSTRAINT ck_orden_id
        CHECK (id_orden > 0)
);
CREATE TABLE tab_det_orden (
    id_orden    DECIMAL(6,0) NOT NULL,  -- Orden a la que pertenece la línea.
    id_prod     SMALLINT     NOT NULL,  -- Producto solicitado.
    val_cant    SMALLINT     NOT NULL,  -- Cantidad solicitada.

    CONSTRAINT pk_det_orden
        PRIMARY KEY (id_orden, id_prod),

    CONSTRAINT fk_det_orden_orden
        FOREIGN KEY (id_orden)
        REFERENCES tab_orden_compra (id_orden)
        ON DELETE CASCADE,

    CONSTRAINT fk_det_orden_prod
        FOREIGN KEY (id_prod)
        REFERENCES tab_prod (id_prod)
        ON DELETE RESTRICT,

    CONSTRAINT ck_det_orden_cant
        CHECK (val_cant > 0)
);
CREATE TABLE tab_enc_compra (
    id_factura       DECIMAL(6,0) NOT NULL,                -- Número de la factura.
    fec_factura      DATE         NOT NULL DEFAULT CURRENT_DATE,  -- Fecha de la factura.
    id_prov          DECIMAL(10,0) NOT NULL,               -- Proveedor que factura.
    id_ciud_entrega  VARCHAR(5)   NOT NULL,                -- Ciudad donde se recibe la compra.
    val_observa      TEXT,                                 -- Observaciones (opcional).


    CONSTRAINT pk_enc_compra
        PRIMARY KEY (id_factura),


    CONSTRAINT fk_enc_prov
        FOREIGN KEY (id_prov)
        REFERENCES tab_prov (id_prov)
        ON DELETE RESTRICT,


    CONSTRAINT fk_enc_ciud
        FOREIGN KEY (id_ciud_entrega)
        REFERENCES tab_ciud (id_ciud)
        ON DELETE RESTRICT,


    CONSTRAINT ck_enc_id
        CHECK (id_factura > 0),


    CONSTRAINT ck_enc_fecha
        CHECK (fec_factura >= DATE '2000-01-01')
);
CREATE TABLE tab_det_compra (
    id_factura  DECIMAL(6,0)  NOT NULL,                -- Factura a la que pertenece la línea.
    id_prod     SMALLINT      NOT NULL,                -- Producto facturado.
    val_cant    SMALLINT      NOT NULL,                -- Unidades compradas.
    val_unit    DECIMAL(10,0) NOT NULL,                -- Valor unitario.
    val_descu   DECIMAL(12,0) NOT NULL DEFAULT 0,      -- Descuento en pesos (0 por defecto).
    porc_iva    DECIMAL(4,2)  NOT NULL DEFAULT 19,     -- Porcentaje de IVA (19 por defecto).


    val_bruto   DECIMAL(12,0)
        GENERATED ALWAYS AS (val_cant * val_unit) STORED,


    val_iva     DECIMAL(12,0)
        GENERATED ALWAYS AS
        (ROUND((val_cant * val_unit - val_descu) * porc_iva / 100)) STORED,


    val_neto    DECIMAL(12,0)
        GENERATED ALWAYS AS
        (val_cant * val_unit - val_descu
         + ROUND((val_cant * val_unit - val_descu) * porc_iva / 100)) STORED,


    CONSTRAINT pk_det_compra
        PRIMARY KEY (id_factura, id_prod),


    CONSTRAINT fk_detcomp_enc
        FOREIGN KEY (id_factura)
        REFERENCES tab_enc_compra (id_factura)
        ON DELETE CASCADE,


    CONSTRAINT fk_detcomp_prod
        FOREIGN KEY (id_prod)
        REFERENCES tab_prod (id_prod)
        ON DELETE RESTRICT,

    CONSTRAINT ck_detcomp_cant
        CHECK (val_cant > 0),


    CONSTRAINT ck_detcomp_unit
        CHECK (val_unit > 0),


    CONSTRAINT ck_detcomp_descu
        CHECK (val_descu >= 0 AND val_descu <= val_cant * val_unit),


    CONSTRAINT ck_detcomp_iva
        CHECK (porc_iva IN (0, 5, 19))
);
CREATE TABLE tab_pagos (
    id_factura  DECIMAL(6,0)  NOT NULL,  -- Factura que se paga.
    id_pago     SMALLINT      NOT NULL,  -- Número del pago dentro de la factura.
    fec_pago    DATE          NOT NULL,  -- Fecha del pago.
    val_pago    DECIMAL(12,0) NOT NULL,  -- Valor pagado.


    CONSTRAINT pk_pagos
        PRIMARY KEY (id_factura, id_pago),


    CONSTRAINT fk_pagos_enc
        FOREIGN KEY (id_factura)
        REFERENCES tab_enc_compra (id_factura)
        ON DELETE RESTRICT,


    CONSTRAINT ck_pagos_id
        CHECK (id_pago > 0),


    CONSTRAINT ck_pagos_valor
        CHECK (val_pago > 0)
);
